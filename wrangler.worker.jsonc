{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "honkytonk-controller",
  "main": "automation/cloudflare/worker.mjs",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": ".cloudflare-worker-assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "browser": {
    "binding": "BROWSER"
  },
  "workflows": [
    {
      "name": "honkytonk-jobs",
      "binding": "HONKYTONK_JOBS",
      "class_name": "HonkyTonkWorkflow"
    }
  ],
  "triggers": {
    "crons": [
      "*/10 * * * *"
    ]
  },
  "limits": {
    "cpu_ms": 300000
  },
  "observability": {
    "enabled": true
  },
  "keep_vars": true
}
